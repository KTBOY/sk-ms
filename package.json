{
  "name": "novel-atlas",
  "private": true,
  "version": "1.0.0",
  "description": "墨枢 NovelAtlas —— AI 小说创作一致性管理工作台（纯前端）",
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "app": "electron .",
    "app:build": "npm run build && electron-builder --win"
  },
  "build": {
    "appId": "com.novelatlas.app",
    "productName": "墨枢NovelAtlas",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**",
      "electron/**"
    ],
    "win": {
      "target": [
        "nsis",
        "portable"
      ]
    }
  },
  "dependencies": {
    "@dicebear/collection": "^9.4.2",
    "@dicebear/core": "^9.4.3",
    "d3": "^7.9.0",
    "docx": "^9.0.2",
    "jszip": "^3.10.1",
    "nanoid": "^5.0.9",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "zustand": "^5.0.2"
  },
  "devDependencies": {
    "@types/d3": "^7.4.3",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "electron": "^44.0.0",
    "electron-builder": "^26.15.3",
    "typescript": "~5.6.3",
    "vite": "^5.4.11"
  }
}
